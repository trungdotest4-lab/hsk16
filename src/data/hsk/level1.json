aracter","vi":"chữ","ex":{"h":"这是什么字？","p":"Zhè shì shénme zì?","vi":"Đây là chữ gì?"}},{"h":"昨天","p":"zuótiān","en":"yesterday","vi":"hôm qua","ex":{"h":"昨天天气很冷。","p":"Zuótiān tiānqì hěn lěng.","vi":"Hôm qua thời tiết rất lạnh."}},{"h":"做","p":"zuò","en":"do; make","vi":"làm","ex":{"h":"你在做什么？","p":"Nǐ zài zuò shénme?","vi":"Bạn đang làm gì?"}},{"h":"坐","p":"zuò","en":"sit","vi":"ngồi; đi (xe, máy bay)","ex":{"h":"请坐。","p":"Qǐng zuò.","vi":"Mời ngồi."}}]