[{"h":"爱","p":"ài","en":"love","vi":"yêu, thích","ex":{"h":"我爱你。","p":"Wǒ ài nǐ.","vi":"Tôi yêu bạn."}},{"h":"八","p":"bā","en":"eight","vi":"số 8","ex":{"h":"现在是八点。","p":"Xiànzài shì bā diǎn.","vi":"Bây giờ là 8 giờ."}},{"h":"爸爸","p":"bàba","en":"Dad","vi":"bố, ba","ex":{"h":"我爸爸是医生。","p":"Wǒ bàba shì yīshēng.","vi":"Bố tôi là bác sĩ."}},{"h":"杯子","p":"bēizi","en":"cup; glass","vi":"cái cốc, cái ly","ex":{"h":"这是我的杯子。","p":"Zhè shì wǒ de bēizi.","vi":"Đây là cốc của tôi."}},{"h":"北京","p":"Běijīng","en":"Beijing","vi":"Bắc Kinh","ex":{"h":"我在北京工作。","p":"Wǒ zài Běijīng gōngzuò.","vi":"Tôi làm việc ở Bắc Kinh."}},{"h":"本","p":"běn","en":"measure word for books","vi":"quyển (lượng từ cho sách)","ex":{"h":"我有三本书。","p":"Wǒ yǒu sān běn shū.","vi":"Tôi có ba quyển sách."}},{"h":"不客气","p":"bú kèqi","en":"you're welcome; don't be polite","vi":"đừng khách sáo","ex":{"h":"不客气！","p":"Bú kèqi!","vi":"Không có gì!"}},{"h":"不","p":"bù","en":"no; not","vi":"không","ex":{"h":"我不喜欢喝茶。","p":"Wǒ bù xǐhuan hē chá.","vi":"Tôi không thích uống trà."}},{"h":"菜","p":"cài","en":"dish (type of food); vegetables","vi":"món ăn, rau","ex":{"h":"这个菜很好吃。","p":"Zhège cài hěn hǎochī.","vi":"Món này rất ngon."}},{"h":"茶","p":"chá","en":"tea","vi":"trà","ex":{"h":"我喜欢喝茶。","p":"Wǒ xǐhuan hē chá.","vi":"Tôi thích uống trà."}},{"h":"吃","p":"chī","en":"eat","vi":"ăn","ex":{"h":"我想吃苹果。","p":"Wǒ xiǎng chī píngguǒ.","vi":"Tôi muốn ăn táo."}},{"h":"出租车","p":"chūzūchē","en":"taxi; cab","vi":"xe taxi","ex":{"h":"我们坐出租车去。","p":"Wǒmen zuò chūzūchē qù.","vi":"Chúng tôi đi taxi."}},{"h":"打电话","p":"dǎ diànhuà","en":"make a phone call","vi":"gọi điện thoại","ex":{"h":"我在打电话。","p":"Wǒ zài dǎ diànhuà.","vi":"Tôi đang gọi điện thoại."}},{"h":"大","p":"dà","en":"big; large","vi":"to, lớn","ex":{"h":"这个苹果很大。","p":"Zhège píngguǒ hěn dà.","vi":"Quả táo này rất to."}},{"h":"的","p":"de","en":"indicates possession, like adding 's to a noun","vi":"của (trợ từ sở hữu)","ex":{"h":"这是我的书。","p":"Zhè shì wǒ de shū.","vi":"Đây là sách của tôi."}},{"h":"点","p":"diǎn","en":"a dot; a little; o'clock","vi":"giờ; một chút","ex":{"h":"现在几点？","p":"Xiànzài jǐ diǎn?","vi":"Bây giờ mấy giờ?"}},{"h":"电脑","p":"diànnǎo","en":"computer","vi":"máy vi tính","ex":{"h":"这是我的电脑。","p":"Zhè shì wǒ de diànnǎo.","vi":"Đây là máy tính của tôi."}},{"h":"电视","p":"diànshì","en":"television; TV","vi":"ti vi, truyền hình","ex":{"h":"我们在看电视。","p":"Wǒmen zài kàn diànshì.","vi":"Chúng tôi đang xem tivi."}},{"h":"电影","p":"diànyǐng","en":"movie; film","vi":"phim, điện ảnh","ex":{"h":"我喜欢看电影。","p":"Wǒ xǐhuan kàn diànyǐng.","vi":"Tôi thích xem phim."}},{"h":"东西","p":"dōngxi","en":"things; stuff","vi":"đồ vật, đồ đạc","ex":{"h":"这是什么东西？","p":"Zhè shì shénme dōngxi?","vi":"Đây là cái gì vậy?"}},{"h":"都","p":"dōu","en":"all; both","vi":"đều","ex":{"h":"我们都是学生。","p":"Wǒmen dōu shì xuésheng.","vi":"Chúng tôi đều là học sinh."}},{"h":"读","p":"dú","en":"to read; to study","vi":"đọc","ex":{"h":"请读这本书。","p":"Qǐng dú zhè běn shū.","vi":"Xin hãy đọc quyển sách này."}},{"h":"对不起","p":"duìbuqǐ","en":"sorry","vi":"xin lỗi","ex":{"h":"对不起，我没有钱。","p":"Duìbuqǐ, wǒ méiyǒu qián.","vi":"Xin lỗi, tôi không có tiền."}},{"h":"多","p":"duō","en":"many","vi":"nhiều","ex":{"h":"这里的人很多。","p":"Zhèlǐ de rén hěn duō.","vi":"Người ở đây rất đông."}},{"h":"多少","p":"duōshao","en":"how much?; how many?","vi":"bao nhiêu","ex":{"h":"这个多少钱？","p":"Zhège duōshao qián?","vi":"Cái này bao nhiêu tiền?"}},{"h":"儿子","p":"érzi","en":"son","vi":"con trai","ex":{"h":"他的儿子是学生。","p":"Tā de érzi shì xuésheng.","vi":"Con trai anh ấy là học sinh."}},{"h":"二","p":"èr","en":"two","vi":"số 2","ex":{"h":"现在是二月。","p":"Xiànzài shì èr yuè.","vi":"Bây giờ là tháng Hai."}},{"h":"饭店","p":"fàndiàn","en":"restaurant; hotel","vi":"nhà hàng, khách sạn","ex":{"h":"我们在饭店吃饭。","p":"Wǒmen zài fàndiàn chīfàn.","vi":"Chúng tôi ăn cơm ở nhà hàng."}},{"h":"飞机","p":"fēijī","en":"airplane","vi":"máy bay","ex":{"h":"他坐飞机去北京。","p":"Tā zuò fēijī qù Běijīng.","vi":"Anh ấy đi máy bay đến Bắc Kinh."}},{"h":"分钟","p":"fēnzhōng","en":"minute; (measure word for time)","vi":"phút","ex":{"h":"我们有十分钟。","p":"Wǒmen yǒu shí fēnzhōng.","vi":"Chúng tôi có mười phút."}},{"h":"高兴","p":"gāoxìng","en":"happy; glad","vi":"vui mừng, vui vẻ","ex":{"h":"很高兴认识你。","p":"Hěn gāoxìng rènshi nǐ.","vi":"Rất vui được quen biết bạn."}},{"h":"个","p":"ge","en":"general measure word","vi":"cái, chiếc (lượng từ)","ex":{"h":"我有一个杯子。","p":"Wǒ yǒu yí ge bēizi.","vi":"Tôi có một cái cốc."}},{"h":"工作","p":"gōngzuò","en":"work; a job","vi":"công việc, làm việc","ex":{"h":"你的工作是什么？","p":"Nǐ de gōngzuò shì shénme?","vi":"Công việc của bạn là gì?"}},{"h":"狗","p":"gǒu","en":"dog","vi":"con chó","ex":{"h":"我喜欢狗。","p":"Wǒ xǐhuan gǒu.","vi":"Tôi thích chó."}},{"h":"汉语","p":"Hànyǔ","en":"Chinese language","vi":"tiếng Hán, tiếng Trung","ex":{"h":"我在学习汉语。","p":"Wǒ zài xuéxí Hànyǔ.","vi":"Tôi đang học tiếng Hán."}},{"h":"好","p":"hǎo","en":"good","vi":"tốt, hay","ex":{"h":"你好吗？","p":"Nǐ hǎo ma?","vi":"Bạn khỏe không?"}},{"h":"号","p":"hào","en":"number; day of a month","vi":"ngày (trong tháng); số","ex":{"h":"今天几号？","p":"Jīntiān jǐ hào?","vi":"Hôm nay là ngày mấy?"}},{"h":"喝","p":"hē","en":"to drink","vi":"uống","ex":{"h":"我想喝水。","p":"Wǒ xiǎng hē shuǐ.","vi":"Tôi muốn uống nước."}},{"h":"和","p":"hé","en":"and; with","vi":"và, với","ex":{"h":"我和你去商店。","p":"Wǒ hé nǐ qù shāngdiàn.","vi":"Tôi và bạn đi cửa hàng."}},{"h":"很","p":"hěn","en":"very; quite","vi":"rất","ex":{"h":"今天很热。","p":"Jīntiān hěn rè.","vi":"Hôm nay rất nóng."}},{"h":"后面","p":"hòumian","en":"back; behind","vi":"phía sau","ex":{"h":"学校后面有商店。","p":"Xuéxiào hòumian yǒu shāngdiàn.","vi":"Phía sau trường học có cửa hàng."}},{"h":"回","p":"huí","en":"to return; to reply; to go back","vi":"trở về, quay lại","ex":{"h":"我回家。","p":"Wǒ huí jiā.","vi":"Tôi về nhà."}},{"h":"会","p":"huì","en":"know how to","vi":"biết, có thể","ex":{"h":"我会说汉语。","p":"Wǒ huì shuō Hànyǔ.","vi":"Tôi biết nói tiếng Hán."}},{"h":"几","p":"jǐ","en":"how many; several; a few","vi":"mấy, vài","ex":{"h":"你家有几个人？","p":"Nǐ jiā yǒu jǐ ge rén?","vi":"Nhà bạn có mấy người?"}},{"h":"家","p":"jiā","en":"family; home","vi":"nhà, gia đình","ex":{"h":"我家在北京。","p":"Wǒ jiā zài Běijīng.","vi":"Nhà tôi ở Bắc Kinh."}},{"h":"叫","p":"jiào","en":"to be called","vi":"gọi, tên là","ex":{"h":"你叫什么名字？","p":"Nǐ jiào shénme míngzi?","vi":"Bạn tên là gì?"}},{"h":"今天","p":"jīntiān","en":"today","vi":"hôm nay","ex":{"h":"今天天气很好。","p":"Jīntiān tiānqì hěn hǎo.","vi":"Hôm nay thời tiết rất đẹp."}},{"h":"九","p":"jiǔ","en":"nine","vi":"số 9","ex":{"h":"现在是九点。","p":"Xiànzài shì jiǔ diǎn.","vi":"Bây giờ là 9 giờ."}},{"h":"开","p":"kāi","en":"to open; to start; to operate (a vehicle)","vi":"mở; lái (xe)","ex":{"h":"商店九点开。","p":"Shāngdiàn jiǔ diǎn kāi.","vi":"Cửa hàng mở lúc 9 giờ."}},{"h":"看","p":"kàn","en":"see; look at; to watch","vi":"nhìn, xem","ex":{"h":"我在看书。","p":"Wǒ zài kàn shū.","vi":"Tôi đang xem sách."}},{"h":"看见","p":"kànjiàn","en":"see; catch sight of","vi":"nhìn thấy","ex":{"h":"我看见他了。","p":"Wǒ kànjiàn tā le.","vi":"Tôi đã nhìn thấy anh ấy."}},{"h":"块","p":"kuài","en":"lump; piece; sum of money","vi":"đồng (tiền); miếng, cục","ex":{"h":"这个五块钱。","p":"Zhège wǔ kuài qián.","vi":"Cái này năm đồng."}},{"h":"来","p":"lái","en":"come; arrive; ever since; next","vi":"đến, tới","ex":{"h":"请你来我家。","p":"Qǐng nǐ lái wǒ jiā.","vi":"Mời bạn đến nhà tôi."}},{"h":"老师","p":"lǎoshī","en":"teacher","vi":"giáo viên, thầy cô","ex":{"h":"她是我的老师。","p":"Tā shì wǒ de lǎoshī.","vi":"Cô ấy là giáo viên của tôi."}},{"h":"了","p":"le","en":"indicates a completed or finished action","vi":"rồi (trợ từ hoàn thành)","ex":{"h":"我吃饭了。","p":"Wǒ chīfàn le.","vi":"Tôi ăn cơm rồi."}},{"h":"冷","p":"lěng","en":"cold","vi":"lạnh","ex":{"h":"今天很冷。","p":"Jīntiān hěn lěng.","vi":"Hôm nay rất lạnh."}},{"h":"里","p":"lǐ","en":"inside; Chinese mile (~.5 km)","vi":"trong, bên trong","ex":{"h":"杯子里有水。","p":"Bēizi lǐ yǒu shuǐ.","vi":"Trong cốc có nước."}},{"h":"六","p":"liù","en":"six","vi":"số 6","ex":{"h":"现在是六月。","p":"Xiànzài shì liù yuè.","vi":"Bây giờ là tháng Sáu."}},{"h":"妈妈","p":"māma","en":"mom; mum","vi":"mẹ, má","ex":{"h":"我妈妈是老师。","p":"Wǒ māma shì lǎoshī.","vi":"Mẹ tôi là giáo viên."}},{"h":"吗","p":"ma","en":"indicates a yes/no question (added to a statement)","vi":"không? (trợ từ nghi vấn)","ex":{"h":"你是学生吗？","p":"Nǐ shì xuésheng ma?","vi":"Bạn là học sinh phải không?"}},{"h":"买","p":"mǎi","en":"to buy","vi":"mua","ex":{"h":"我想买苹果。","p":"Wǒ xiǎng mǎi píngguǒ.","vi":"Tôi muốn mua táo."}},{"h":"猫","p":"māo","en":"cat","vi":"con mèo","ex":{"h":"我喜欢猫。","p":"Wǒ xǐhuan māo.","vi":"Tôi thích mèo."}},{"h":"没关系","p":"méi guānxi","en":"it doesn't matter; never mind","vi":"không sao, không có gì","ex":{"h":"没关系，谢谢你。","p":"Méi guānxi, xièxie nǐ.","vi":"Không sao đâu, cảm ơn bạn."}},{"h":"没有","p":"méiyǒu","en":"not have; there is not","vi":"không có","ex":{"h":"我没有钱。","p":"Wǒ méiyǒu qián.","vi":"Tôi không có tiền."}},{"h":"米饭","p":"mǐfàn","en":"(cooked) rice","vi":"cơm","ex":{"h":"我想吃米饭。","p":"Wǒ xiǎng chī mǐfàn.","vi":"Tôi muốn ăn cơm."}},{"h":"明天","p":"míngtiān","en":"tomorrow","vi":"ngày mai","ex":{"h":"明天是星期几？","p":"Míngtiān shì xīngqī jǐ?","vi":"Ngày mai là thứ mấy?"}},{"h":"名字","p":"míngzi","en":"name","vi":"tên, họ tên","ex":{"h":"你的名字是什么？","p":"Nǐ de míngzi shì shénme?","vi":"Tên của bạn là gì?"}},{"h":"哪","p":"nǎa","en":"which; how","vi":"nào","ex":{"h":"你喜欢哪个？","p":"Nǐ xǐhuan nǎge?","vi":"Bạn thích cái nào?"}},{"h":"哪儿","p":"nǎr","en":"where? (Beijing accent)","vi":"ở đâu","ex":{"h":"你在哪儿？","p":"Nǐ zài nǎr?","vi":"Bạn đang ở đâu?"}},{"h":"那","p":"nà","en":"that; then","vi":"kia, đó","ex":{"h":"那是我的书。","p":"Nà shì wǒ de shū.","vi":"Đó là sách của tôi."}},{"h":"呢","p":"ne","en":"indicates a question; how about...?;","vi":"thì sao? (trợ từ)","ex":{"h":"我很好，你呢？","p":"Wǒ hěn hǎo, nǐ ne?","vi":"Tôi khỏe, còn bạn thì sao?"}},{"h":"能","p":"néng","en":"can; be able","vi":"có thể","ex":{"h":"你能来吗？","p":"Nǐ néng lái ma?","vi":"Bạn có thể đến không?"}},{"h":"你","p":"nǐ","en":"you (singular)","vi":"bạn, anh, chị","ex":{"h":"你好！","p":"Nǐ hǎo!","vi":"Xin chào!"}},{"h":"年","p":"nián","en":"year","vi":"năm","ex":{"h":"我在中国三年了。","p":"Wǒ zài Zhōngguó sān nián le.","vi":"Tôi ở Trung Quốc ba năm rồi."}},{"h":"女儿","p":"nǚ'ér","en":"daughter","vi":"con gái","ex":{"h":"她是我的女儿。","p":"Tā shì wǒ de nǚ'ér.","vi":"Cô bé đó là con gái tôi."}},{"h":"朋友","p":"péngyou","en":"friend","vi":"bạn, bạn bè","ex":{"h":"他是我的朋友。","p":"Tā shì wǒ de péngyou.","vi":"Anh ấy là bạn của tôi."}},{"h":"漂亮","p":"piàoliang","en":"pretty; beautiful","vi":"xinh đẹp","ex":{"h":"她很漂亮。","p":"Tā hěn piàoliang.","vi":"Cô ấy rất xinh đẹp."}},{"h":"苹果","p":"píngguǒ","en":"apple","vi":"quả táo","ex":{"h":"我喜欢吃苹果。","p":"Wǒ xǐhuan chī píngguǒ.","vi":"Tôi thích ăn táo."}},{"h":"七","p":"qī","en":"seven","vi":"số 7","ex":{"h":"现在是七点。","p":"Xiànzài shì qī diǎn.","vi":"Bây giờ là 7 giờ."}},{"h":"钱","p":"qián","en":"money; coin","vi":"tiền","ex":{"h":"你有钱吗？","p":"Nǐ yǒu qián ma?","vi":"Bạn có tiền không?"}},{"h":"前面","p":"qiánmiàn","en":"in front","vi":"phía trước","ex":{"h":"前面有一个商店。","p":"Qiánmiàn yǒu yí ge shāngdiàn.","vi":"Phía trước có một cửa hàng."}},{"h":"请","p":"qǐng","en":"please; invite; to treat someone to something","vi":"mời, xin mời","ex":{"h":"请喝茶。","p":"Qǐng hē chá.","vi":"Mời uống trà."}},{"h":"去","p":"qù","en":"go; to leave","vi":"đi, đến","ex":{"h":"我们去学校。","p":"Wǒmen qù xuéxiào.","vi":"Chúng tôi đi đến trường."}},{"h":"热","p":"rè","en":"heat; hot","vi":"nóng","ex":{"h":"这个茶很热。","p":"Zhège chá hěn rè.","vi":"Trà này rất nóng."}},{"h":"人","p":"rén","en":"person; man; people","vi":"người","ex":{"h":"这里有很多人。","p":"Zhèlǐ yǒu hěn duō rén.","vi":"Ở đây có rất nhiều người."}},{"h":"认识","p":"rènshi","en":"recognize; know (a person)","vi":"quen biết","ex":{"h":"我想认识你的朋友。","p":"Wǒ xiǎng rènshi nǐ de péngyou.","vi":"Tôi muốn làm quen với bạn của bạn."}},{"h":"三","p":"sān","en":"three","vi":"số 3","ex":{"h":"我家有三个人。","p":"Wǒ jiā yǒu sān ge rén.","vi":"Nhà tôi có ba người."}},{"h":"商店","p":"shāngdiàn","en":"shop; store","vi":"cửa hàng","ex":{"h":"这个商店很大。","p":"Zhège shāngdiàn hěn dà.","vi":"Cửa hàng này rất lớn."}},{"h":"上","p":"shàng","en":"above; up","vi":"trên, phía trên","ex":{"h":"书在桌子上。","p":"Shū zài zhuōzi shàng.","vi":"Sách ở trên bàn."}},{"h":"上午","p":"shàngwǔ","en":"late morning (before noon)","vi":"buổi sáng","ex":{"h":"现在是上午。","p":"Xiànzài shì shàngwǔ.","vi":"Bây giờ là buổi sáng."}},{"h":"少","p":"shǎo","en":"few; little","vi":"ít","ex":{"h":"这里的人很少。","p":"Zhèlǐ de rén hěn shǎo.","vi":"Người ở đây rất ít."}},{"h":"谁","p":"shéi","en":"who","vi":"ai","ex":{"h":"他是谁？","p":"Tā shì shéi?","vi":"Anh ấy là ai?"}},{"h":"什么","p":"shénme","en":"what? (replaces the noun to turn a statement into a question)","vi":"cái gì","ex":{"h":"这是什么？","p":"Zhè shì shénme?","vi":"Đây là cái gì?"}},{"h":"十","p":"shí","en":"ten","vi":"số 10","ex":{"h":"现在是十点。","p":"Xiànzài shì shí diǎn.","vi":"Bây giờ là 10 giờ."}},{"h":"时候","p":"shíhou","en":"time","vi":"lúc, khi","ex":{"h":"你什么时候来？","p":"Nǐ shénme shíhou lái?","vi":"Khi nào bạn đến?"}},{"h":"是","p":"shì","en":"be; is; are; am","vi":"là, phải","ex":{"h":"他是老师，我是学生。","p":"Tā shì lǎoshī, wǒ shì xuésheng.","vi":"Anh ấy là giáo viên, tôi là học sinh."}},{"h":"书","p":"shū","en":"book; letter","vi":"sách","ex":{"h":"桌子上有三本书。","p":"Zhuōzi shàng yǒu sān běn shū.","vi":"Trên bàn có ba quyển sách."}},{"h":"水","p":"shuǐ","en":"water","vi":"nước","ex":{"h":"杯子里没有水。","p":"Bēizi lǐ méiyǒu shuǐ.","vi":"Trong cốc không có nước."}},{"h":"水果","p":"shuǐguǒ","en":"fruit","vi":"hoa quả, trái cây","ex":{"h":"我喜欢吃水果。","p":"Wǒ xǐhuan chī shuǐguǒ.","vi":"Tôi thích ăn hoa quả."}},{"h":"睡觉","p":"shuì jiào","en":"to sleep; go to bed","vi":"ngủ","ex":{"h":"我很想睡觉。","p":"Wǒ hěn xiǎng shuìjiào.","vi":"Tôi rất muốn ngủ."}},{"h":"说","p":"shuō","en":"speak","vi":"nói","ex":{"h":"请说汉语。","p":"Qǐng shuō Hànyǔ.","vi":"Xin hãy nói tiếng Hán."}},{"h":"四","p":"sì","en":"four","vi":"số 4","ex":{"h":"现在是四月。","p":"Xiànzài shì sì yuè.","vi":"Bây giờ là tháng Tư."}},{"h":"岁","p":"suì","